{
  "name": "pc-optimizer-drive-manager",
  "version": "1.0.0",
  "description": "PC Optimizer and Drive C Transfer Tool for Windows",
  "main": "main.js",
  "scripts": {
    "server": "node server.js",
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pcoptimizer.app",
    "productName": "PC Optimizer",
    "copyright": "Copyright © 2026",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraFiles": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "PC-Optimizer-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PC-Optimizer-Setup.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
